<section class="section{% if section.settings.sand %} section--sand{% endif %}" aria-labelledby="pk-{{ section.id }}">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h1" id="pk-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="packages">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <article class="package reveal" {{ block.shopify_attributes }}>
          <p class="package__serves">{{ block.settings.serves }}<small>{{ block.settings.unit }}</small></p>
          <h3 class="h3">{{ block.settings.title | default: p.title }}</h3>
          {%- if p != blank -%}<p class="price" style="font-weight:700;font-size:20px">{% if p.price_varies %}<span class="muted small">from </span>{% endif %}{{ p.price_min | money }}</p>{%- endif -%}
          <div class="package__includes rte">{{ block.settings.includes | default: p.description }}</div>
          {%- if p != blank -%}<a class="btn btn--block" href="{{ p.url }}">{% if p.has_only_default_variant %}Order this feast{% else %}Choose your trays{% endif %}</a>{%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}<div class="note rte" style="margin-top:20px">{{ section.settings.footnote }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Party packages",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line", "default": "Party packages" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your party size" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "richtext", "id": "footnote", "label": "Small print" },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": false }
  ],
  "blocks": [
    { "type": "package", "name": "Package", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "text", "id": "serves", "label": "Number shown big", "default": "15" },
      { "type": "text", "id": "unit", "label": "Unit", "default": "guests" },
      { "type": "text", "id": "title", "label": "Title", "info": "Empty = product title." },
      { "type": "richtext", "id": "includes", "label": "What's included", "info": "Empty = product description." } ] }
  ],
  "presets": [ { "name": "Party packages" } ]
}
{% endschema %}
