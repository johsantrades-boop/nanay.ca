{%- assign s = section.settings -%}
<section class="section{% if s.sand %} section--sand{% endif %}" aria-labelledby="mt-{{ section.id }}">
  <div class="container media-text{% if s.flip %} media-text--flip{% endif %}">
    <div class="media-text__img reveal">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1400', sizes: '(min-width: 860px) 50vw, 100vw', loading: 'lazy' }}
      {%- elsif s.fallback != 'none' -%}
        <img src="{{ s.fallback | append: '.webp' | asset_url }}" alt="{{ s.image_alt }}" loading="lazy" width="1200" height="900">
      {%- endif -%}
      {%- if s.tag != blank -%}<span class="badge badge--yolk media-text__tag">{{ s.tag }}</span>{%- endif -%}
    </div>
    <div class="stack reveal">
      {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker }}</p>{%- endif -%}
      <h2 class="h1" id="mt-{{ section.id }}">{{ s.heading }}</h2>
      <div class="rte lead" style="color:var(--text)">{{ s.text }}</div>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'tip' -%}
            <p class="pro-tip" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<span>{{ block.settings.text }}</span></p>
          {%- when 'line' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- endcase -%}
      {%- endfor -%}
      {%- if s.button_label != blank -%}
        <p><a class="btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a></p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback", "label": "Built-in photo (if no image chosen)", "options": [
      { "value": "photo-silog", "label": "Silog feast" }, { "value": "photo-inihaw", "label": "Inihaw trays" }, { "value": "photo-skewers", "label": "Grilled skewers" },
      { "value": "photo-party-feast", "label": "Party feast" }, { "value": "photo-palabok", "label": "Palabok" }, { "value": "photo-catering", "label": "Catering trays" }, { "value": "none", "label": "None" } ], "default": "photo-silog" },
    { "type": "text", "id": "image_alt", "label": "Image description (for screen readers)", "default": "Silog feast: garlic fried rice topped with fried eggs, with tapa, longganisa and bangus" },
    { "type": "text", "id": "tag", "label": "Badge on image" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": false },
    { "type": "text", "id": "kicker", "label": "Small line" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Silogs, all day" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "tip", "name": "Tip", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "egg", "label": "Egg" }, { "value": "fire", "label": "Fire" }, { "value": "leaf", "label": "Leaf" }, { "value": "info", "label": "Info" } ], "default": "egg" },
      { "type": "text", "id": "text", "label": "Text", "default": "PRO-TIP: ask us for crispy fried wok eggs" } ] },
    { "type": "line", "name": "Extra text", "settings": [ { "type": "richtext", "id": "text", "label": "Text" } ] }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
