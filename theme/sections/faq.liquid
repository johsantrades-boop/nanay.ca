<section class="section{% if section.settings.sand %} section--sand{% endif %}" aria-labelledby="faq-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h1" id="faq-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">
            {%- case block.settings.answer_source -%}
              {%- when 'hours' -%}<p>{{ settings.hours }}. Pickup at {{ settings.pickup_name }}{% if settings.pickup_address != blank %}, {{ settings.pickup_address }}{% endif %}.{% if settings.map_url != blank %} <a href="{{ settings.map_url }}" target="_blank" rel="noopener">Open in Google Maps</a>.{% endif %}</p>
              {%- when 'delivery' -%}<p>{{ settings.delivery_note }}</p>
              {%- when 'policy' -%}<p>{{ settings.refund_policy }}</p>
            {%- endcase -%}
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for block in section.blocks -%}
  { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | default: block.settings.question | json }} } }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
] }
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "checkbox", "id": "schema_markup", "label": "Mark up for Google", "default": true },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": false }
  ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "select", "id": "answer_source", "label": "Start the answer with", "options": [ { "value": "none", "label": "Nothing" }, { "value": "hours", "label": "Hours and pickup (from Theme settings)" }, { "value": "delivery", "label": "Delivery note (from Theme settings)" }, { "value": "policy", "label": "Refund policy (from Theme settings)" } ], "default": "none" },
      { "type": "richtext", "id": "answer", "label": "Answer" } ] }
  ],
  "presets": [ { "name": "FAQ" } ]
}
{% endschema %}
