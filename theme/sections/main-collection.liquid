<section class="page-hero page-hero--sand">
  <div class="container">
    <p class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ pages['menu'].url | default: routes.collections_url }}">Menu</a></p>
    <h1 class="h1" style="margin-top:10px">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="lead rte">{{ collection.description }}</div>{%- endif -%}
  </div>
</section>
<div class="container section--tight">
  {%- paginate collection.products by section.settings.per_page -%}
    {%- if collection.products.size > 0 -%}
      <div class="grid grid--4">
        {%- for product in collection.products -%}
          {%- liquid
            assign eager = false
            if forloop.index < 5
              assign eager = true
            endif
          -%}
          {% render 'product-card', product: product, show_desc: true, eager: eager %}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav aria-label="Pagination">
          <ul class="pagination">
            {%- for part in paginate.parts -%}
              <li>{%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="is-current" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}</li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="cart-empty">
        <p class="h2">Nothing here right now</p>
        <p class="muted">This menu may be seasonal. Text us at {{ settings.phone_display }} to ask what's cooking.</p>
        <a class="btn" href="{{ pages['menu'].url | default: routes.all_products_collection_url }}">See the full menu</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
