{%- assign s = section.settings -%}
<section class="section section--tight" aria-labelledby="cta-{{ section.id }}">
  <div class="container">
    <div class="cta-band reveal">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        <img src="{{ s.fallback | append: '.webp' | asset_url }}" alt="" loading="lazy" width="1200" height="900">
      {%- endif -%}
      <div class="cta-band__body">
        {%- if s.kicker != blank -%}<p class="kicker" style="color:var(--yolk)">{{ s.kicker }}</p>{%- endif -%}
        <h2 class="h1" id="cta-{{ section.id }}">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<p class="hero__sub">{{ s.text }}</p>{%- endif -%}
        <div class="hero__actions">
          {%- if s.button_1_label != blank -%}<a class="btn" href="{{ s.button_1_link | default: routes.root_url }}">{{ s.button_1_label }}</a>{%- endif -%}
          {%- if s.show_text_button -%}<a class="btn btn--outline" href="sms:{{ settings.sms_number }}">{% render 'icon', name: 'chat' %}Text {{ settings.phone_display }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call-to-action banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback", "label": "Built-in photo", "options": [ { "value": "photo-catering", "label": "Catering trays" }, { "value": "photo-party-feast", "label": "Party feast" }, { "value": "photo-inihaw", "label": "Inihaw trays" } ], "default": "photo-catering" },
    { "type": "text", "id": "kicker", "label": "Small line", "default": "For parties and handaan" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Feeding 30, 50 or 100?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Birthdays, weddings, office lunches and fiestas. Tell us the date and headcount and we'll plan the trays." },
    { "type": "text", "id": "button_1_label", "label": "Button", "default": "Plan your catering" },
    { "type": "url", "id": "button_1_link", "label": "Button link" },
    { "type": "checkbox", "id": "show_text_button", "label": "Show 'Text us' button", "default": true }
  ],
  "presets": [ { "name": "Call-to-action banner" } ]
}
{% endschema %}
