{%- assign s = section.settings -%}
<section class="page-hero{% if s.sand %} page-hero--sand{% endif %}">
  <div class="container page-hero__row">
    <div>
      {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker }}</p>{%- endif -%}
      <h1 class="h1" style="margin-top:10px">{{ s.heading | default: page.title }}</h1>
      {%- if s.text != blank -%}<div class="lead rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank or s.show_text_button -%}
        <div class="hero__actions" style="margin-top:24px">
          {%- if s.button_label != blank -%}<a class="btn" href="{{ s.button_link | default: '#enquiry' }}">{{ s.button_label }}</a>{%- endif -%}
          {%- if s.show_text_button -%}<a class="btn btn--outline" href="sms:{{ settings.sms_number }}">{% render 'icon', name: 'chat' %}Text {{ settings.phone_display }}</a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if s.image != blank or s.fallback != 'none' -%}
      <div class="page-hero__img">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 900px) 45vw, 100vw', loading: 'eager', alt: s.image_alt }}
        {%- else -%}
          <img src="{{ s.fallback | append: '.webp' | asset_url }}" alt="{{ s.image_alt }}" width="1200" height="900">
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Empty = page title." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty = jumps to the enquiry form on this page." },
    { "type": "checkbox", "id": "show_text_button", "label": "Show 'Text us' button", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback", "label": "Built-in photo (if no image)", "options": [
      { "value": "none", "label": "None" }, { "value": "photo-catering", "label": "Catering trays" }, { "value": "photo-party-feast", "label": "Party feast" },
      { "value": "photo-inihaw", "label": "Inihaw trays" }, { "value": "photo-silog", "label": "Silog feast" }, { "value": "photo-skewers", "label": "Grilled skewers" }, { "value": "photo-palabok", "label": "Palabok" } ], "default": "none" },
    { "type": "text", "id": "image_alt", "label": "Image description" },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": true }
  ],
  "presets": [ { "name": "Page header" } ]
}
{% endschema %}
