<section class="section{% if section.settings.sand %} section--sand{% endif %}" aria-labelledby="why-{{ section.id }}">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h1" id="why-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <div class="why">
      {%- for block in section.blocks -%}
        <div class="why__item reveal" style="transition-delay: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
          <span class="why__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          <h3 class="h3">{{ block.settings.title }}</h3>
          <p class="muted">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Nanay",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line", "default": "Why Nanay" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cooked with love, the way it should be" },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": false }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Local ingredients" },
      { "type": "textarea", "id": "text", "label": "Text" } ] }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Why Nanay" } ]
}
{% endschema %}
