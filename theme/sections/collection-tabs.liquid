<section class="section{% if section.settings.sand %} section--sand{% endif %}" aria-labelledby="ct-{{ section.id }}">
  <div class="container">
    <div class="menu-group__head reveal">
      <div class="stack-sm">
        {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="h1" id="ct-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <a class="link-arrow" href="{{ pages['menu'].url | default: routes.all_products_collection_url }}">See the full menu</a>
    </div>

    <div data-tabs>
      <div class="chips tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          <button class="chip" type="button" role="tab" id="tab-{{ block.id }}" aria-controls="panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label | default: c.title }}</button>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <div class="tab-panel" role="tabpanel" id="panel-{{ block.id }}" aria-labelledby="tab-{{ block.id }}"{% unless forloop.first %} hidden{% endunless %}>
          {%- if block.settings.note != blank -%}<p class="muted" style="margin-bottom:16px">{{ block.settings.note }}</p>{%- endif -%}
          <div class="scroller">
            {%- for product in c.products limit: section.settings.limit -%}
              {% render 'product-card', product: product %}
            {%- else -%}
              <p class="muted">Choose a collection for this tab in the theme editor.</p>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Menu highlights (tabs)",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line", "default": "The menu" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something for every table" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "sand", "label": "Sand background", "default": false }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "label", "label": "Tab label" },
      { "type": "text", "id": "note", "label": "Note under tab" } ] }
  ],
  "presets": [ { "name": "Menu highlights (tabs)" } ]
}
{% endschema %}
