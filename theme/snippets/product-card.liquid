{%- comment -%}
  Params: product (required), show_desc (bool), eager (bool), fallback (asset name, shown when the product has no photo)
  "Good for" comes from the product metafield custom.serves, or from "(Good for …)" in the title.
{%- endcomment -%}
{%- liquid
  assign title = product.title
  assign serves = product.metafields.custom.serves.value
  if title contains '(Good for'
    assign parts = title | split: '(Good for'
    assign title = parts.first | strip
    if serves == blank
      assign serves = parts.last | remove: ')' | strip
    endif
  endif
  assign img = product.featured_media.preview_image
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif
  assign tag_text = ''
  for t in product.tags
    assign tl = t | downcase
    if tl == 'vegan' or tl == 'gluten-free' or tl == 'bestseller' or tl == 'new' or tl == 'frozen'
      assign tag_text = t
      break
    endif
  endfor
-%}
<article class="card{% if img == blank and fallback == blank %} card--noimg{% endif %}" data-title="{{ product.title | downcase | escape }}">
  <div class="card__img">
    {%- if img -%}
      {{ img | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 1000px) 25vw, (min-width: 600px) 45vw, 90vw', loading: loading, alt: product.title }}
    {%- elsif fallback != blank -%}
      <img src="{{ fallback | append: '.webp' | asset_url }}" alt="" loading="{{ loading }}" width="480" height="480">
    {%- endif -%}
    <div class="card__badges">
      {%- if serves != blank -%}<span class="badge">{% render 'icon', name: 'people' %}{{ serves }}</span>{%- endif -%}
      {%- if tag_text != '' -%}<span class="badge badge--yolk">{{ tag_text }}</span>{%- endif -%}
      {%- unless product.available -%}<span class="badge badge--sold">Sold out</span>{%- endunless -%}
    </div>
  </div>
  <div class="card__body">
    <h3 class="card__title"><a href="{{ product.url }}">{{ title }}</a></h3>
    {%- if show_desc and product.description != blank -%}
      <p class="card__desc">{{ product.description | strip_html | truncate: 120 }}</p>
    {%- endif -%}
    <div class="card__meta">
      <p class="card__price price">
        {%- if product.price_varies -%}<small>from </small>{%- endif -%}{{ product.price_min | money }}
      </p>
      {%- if product.available -%}
        {%- if product.has_only_default_variant -%}
          <form class="card__add" action="{{ routes.cart_add_url }}" method="post" data-add-form>
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button class="btn btn--sm" type="submit">Add<span class="visually-hidden"> {{ title }} to cart</span></button>
          </form>
        {%- else -%}
          <a class="btn btn--sm btn--outline card__add" href="{{ product.url }}">Choose<span class="visually-hidden"> options for {{ title }}</span></a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</article>
