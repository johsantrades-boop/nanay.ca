{%- comment -%} Cart drawer. Items are drawn by assets/theme.js from /cart.js so it stays in sync after every add. {%- endcomment -%}
<div class="drawer" id="cart-drawer" aria-hidden="true">
  <button class="drawer__scrim" type="button" data-close tabindex="-1" aria-label="Close cart"></button>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title">
    <div class="drawer__head">
      <h2 class="drawer__title" id="cart-drawer-title">Your order</h2>
      <button class="icon-btn" type="button" data-close>{% render 'icon', name: 'close' %}<span class="visually-hidden">Close cart</span></button>
    </div>
    <form class="drawer__body" action="{{ routes.cart_url }}" method="post" id="cart-drawer-form" novalidate>
      <div data-cart-items aria-live="polite"></div>
      {% render 'cart-options', form_id: 'cart-drawer-form', scope: 'drawer' %}
    </form>
    <div class="drawer__foot" data-cart-foot>
      <div class="cart-sub"><span>Subtotal</span><span class="price" data-cart-subtotal>{{ cart.total_price | money }}</span></div>
      <p class="note">Taxes and any delivery fee are added at checkout.</p>
      <p class="cart-progress" data-cart-progress hidden></p>
      <div class="receipt-actions" style="margin-top:12px">
        <button class="btn btn--block" type="submit" name="checkout" form="cart-drawer-form">Checkout</button>
        <a class="btn btn--outline btn--block" href="{{ routes.cart_url }}">View cart</a>
      </div>
    </div>
  </div>
</div>
