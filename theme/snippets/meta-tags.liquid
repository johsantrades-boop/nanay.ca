{%- liquid
  assign og_type = 'website'
  assign og_image = settings.share_image
  if request.page_type == 'product'
    assign og_type = 'product'
    assign og_image = product.featured_image | default: og_image
  elsif request.page_type == 'collection' and collection.image
    assign og_image = collection.image
  elsif request.page_type == 'article' and article.image
    assign og_image = article.image
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ seo_title | strip | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ seo_description | strip_html | escape | truncate: 200 }}">
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
{%- else -%}
  <meta property="og:image" content="https:{{ 'hero-broll-poster.jpg' | asset_url }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | strip | escape }}">
<meta name="twitter:description" content="{{ seo_description | strip_html | escape | truncate: 200 }}">
