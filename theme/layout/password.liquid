<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} | Opening soon</title>
  <style>:root { --bg: {{ settings.color_bg }}; --surface: #fff; --sand: {{ settings.color_sand }}; --text: {{ settings.color_text }}; --muted: {{ settings.color_muted }}; --primary: {{ settings.color_primary }}; --primary-hover: {{ settings.color_primary_hover }}; --on-primary: #fff; --aqua: {{ settings.color_aqua }}; --border: {{ settings.color_border }}; --border-control: {{ settings.color_border_control }}; }</style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body style="background:var(--aqua)">
  {{ content_for_layout }}
</body>
</html>
