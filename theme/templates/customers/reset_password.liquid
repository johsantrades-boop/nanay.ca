<div class="container section stack" style="max-width:520px">
  <h1 class="h1">Choose a new password</h1>
  <div class="panel">
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-msg form-msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form-grid">
        <div class="field"><label for="rp-pw">New password</label><input class="input" id="rp-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
        <div class="field"><label for="rp-pw2">Confirm password</label><input class="input" id="rp-pw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
        <button class="btn btn--block" type="submit">Reset password</button>
      </div>
    {%- endform -%}
  </div>
</div>
