<div class="container section stack" style="max-width:760px">
  <p class="breadcrumbs"><a href="{{ routes.account_url }}">Account</a> / Addresses</p>
  <h1 class="h1">Addresses</h1>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div class="panel stack">
        {%- if address == customer.default_address -%}<span class="badge">Default</span>{%- endif -%}
        {{ address | format_address }}
        <details>
          <summary class="link-arrow" style="cursor:pointer">Edit</summary>
          {% render 'address-form', address: address %}
        </details>
        <form method="post" action="{{ address.url }}" onsubmit="return confirm('Delete this address?')">
          <input type="hidden" name="_method" value="delete">
          <button class="link-btn" type="submit">Delete</button>
        </form>
      </div>
    {%- endfor -%}
  {%- endpaginate -%}
  <details class="panel" {% if customer.addresses_count == 0 %}open{% endif %}>
    <summary class="h3" style="cursor:pointer">Add a new address</summary>
    {% render 'address-form', address: customer.new_address %}
  </details>
</div>
