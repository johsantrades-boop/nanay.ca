{% layout 'password' %}
<main class="container section" style="max-width:560px;min-height:100svh;display:grid;align-content:center;gap:24px;text-align:center">
  <p class="logo" style="justify-items:center"><span class="logo__word" style="font-size:72px">NANAY</span><span class="logo__sub">FILIPINO COMFORT FOOD</span></p>
  {%- if shop.password_message != blank -%}<p class="lead" style="margin-inline:auto;color:var(--text)">{{ shop.password_message }}</p>{%- endif -%}
  <div class="panel">
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="form-msg form-msg--err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="form-grid">
        <div class="field"><label for="sp-pw">{{ 'general.password_page.login_form_password_label' | t }}</label><input class="input" id="sp-pw" type="password" name="password" autocomplete="current-password" required></div>
        <button class="btn btn--block" type="submit">{{ 'general.password_page.login_form_submit' | t }}</button>
      </div>
    {%- endform -%}
  </div>
  <p class="muted">Questions? Text {{ settings.phone_display }}</p>
</main>
